<?xml version="1.0" encoding="UTF-8"?>
<!--
  The three assertion styles, on ONE failing assertion, so the failure MESSAGE
  is the thing being compared rather than the syntax.

  All three are declared explicitly and at pinned versions, because the video
  makes a claim about what is on your classpath: JUnit 5 alone gives you
  neither AssertJ nor Hamcrest, and spring-boot-starter-test gives you both.
  Read off Maven Central on 2026-09-15, see production/assertions-claims.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.codewithsam</groupId>
  <artifactId>assertions-demos</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
    <assertj.version>3.27.3</assertj.version>
    <hamcrest.version>3.0</hamcrest.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>${hamcrest.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- The failures ARE the output. Never stop the run on the first. -->
          <testFailureIgnore>true</testFailureIgnore>
        </configuration>
      </plugin>
      <!--
        Coverage, so the episode can make its most important point with a
        measurement rather than an assertion: the gutter goes green when a line
        RAN, and says nothing about whether anything CHECKED it.
      -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
